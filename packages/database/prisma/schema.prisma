// Trading Copilot — Milestone 1 database schema.
//
// PostgreSQL is the permanent source of truth (see root CLAUDE.md). Every
// model here maps field-for-field onto the plain domain interfaces in
// packages/trading-domain/src/entities.ts — keep them in sync when either
// changes. Mapping is done in src/mappers.ts, never by leaking these
// generated Prisma types across the package boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetClass {
  FUTURES
  FOREX
  CRYPTO
  STOCK
}

enum StrategyVersionStatus {
  DISCOVERED
  BACKTESTING
  VALIDATION
  OUT_OF_SAMPLE
  WALK_FORWARD
  PAPER_TRADING
  APPROVED
  PAUSED
  RETIRED
}

enum BacktestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Direction {
  LONG
  SHORT
}

enum TradeExitReason {
  STOP
  TARGET
  SAME_CANDLE_STOP_AND_TARGET
  END_OF_DATA
}

model Instrument {
  id                    String     @id @default(uuid())
  symbol                String
  name                  String
  assetClass            AssetClass
  exchange              String
  currency              String
  tickSize              Decimal    @db.Decimal(18, 8)
  tickValue             Decimal    @db.Decimal(18, 8)
  pointValue            Decimal    @db.Decimal(18, 8)
  commissionPerContract Decimal    @db.Decimal(18, 8)
  timezone              String
  sessionConfiguration  Json
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  candles                       Candle[]
  backtests                     Backtest[]
  backtestTrades                BacktestTrade[]
  marketSnapshots               MarketSnapshot[]
  setups                        Setup[]
  journalTrades                 JournalTrade[]
  tradingViewInstrumentMappings TradingViewInstrumentMapping[]

  @@unique([symbol, exchange])
}

model Candle {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  // Intentionally a plain String, NOT a Prisma enum. Prisma enum values must
  // be valid identifiers, and shared-types TIMEFRAMES values ("1m", "5m",
  // "1h", ...) start with a digit, which Prisma does not allow as an enum
  // value. Timeframe is validated against TIMEFRAMES from
  // @trading-copilot/shared-types at the application layer instead — see
  // src/candle-importer.ts and src/repositories/candles.ts. A CHECK
  // constraint mirroring TIMEFRAMES could be hand-added via raw SQL in a
  // future migration if stronger DB-level enforcement is wanted.
  timeframe String

  timestamp DateTime
  open      Decimal  @db.Decimal(18, 8)
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    Decimal  @db.Decimal(18, 8)

  @@unique([instrumentId, timeframe, timestamp])
  @@index([instrumentId, timeframe, timestamp])
}

model Strategy {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  versions      StrategyVersion[]
  setups        Setup[]
  journalTrades JournalTrade[]
}

// StrategyVersion rows are immutable once created — see CLAUDE.md and
// .claude/agents/data-engineer.md. src/repositories/strategies.ts only ever
// exposes a `createStrategyVersion` function; there is deliberately no
// update/mutate function for `parameters` or `version`. A change to a
// strategy always creates a brand-new version row.
model StrategyVersion {
  id          String                @id @default(uuid())
  strategyId  String
  strategy    Strategy              @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  version     String
  name        String
  description String
  parameters  Json
  status      StrategyVersionStatus
  createdAt   DateTime              @default(now())

  backtests      Backtest[]
  backtestTrades BacktestTrade[]
  setups         Setup[]
  journalTrades  JournalTrade[]

  @@unique([strategyId, version])
}

model Backtest {
  id                String          @id @default(uuid())
  strategyVersionId String
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id])
  instrumentId      String
  instrument        Instrument      @relation(fields: [instrumentId], references: [id])

  // See Candle.timeframe note above — plain String, validated against
  // TIMEFRAMES at the application layer.
  timeframe String

  startDate DateTime
  endDate   DateTime

  status BacktestStatus @default(QUEUED)

  // Shape (see BacktestAssumptions in packages/trading-domain):
  // { commissionPerContract: string, slippageTicks: number, riskPercentage: string, initialBalance: string }
  assumptions Json

  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  trades  BacktestTrade[]
  metrics BacktestMetrics?
}

model BacktestTrade {
  id                String          @id @default(uuid())
  backtestId        String
  backtest          Backtest        @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  strategyVersionId String
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id])
  instrumentId      String
  instrument        Instrument      @relation(fields: [instrumentId], references: [id])

  direction Direction

  signalTimestamp DateTime

  entryTimestamp DateTime
  entryPrice     Decimal  @db.Decimal(18, 8)

  stopPrice   Decimal @db.Decimal(18, 8)
  targetPrice Decimal @db.Decimal(18, 8)

  exitTimestamp DateTime
  exitPrice     Decimal  @db.Decimal(18, 8)

  entryReason String
  exitReason  TradeExitReason

  quantity Int

  grossPnl Decimal @db.Decimal(18, 8)
  fees     Decimal @db.Decimal(18, 8)
  netPnl   Decimal @db.Decimal(18, 8)

  riskAmount Decimal @db.Decimal(18, 8)
  rMultiple  Decimal @db.Decimal(18, 8)

  maximumFavorableExcursion Decimal @db.Decimal(18, 8)
  maximumAdverseExcursion   Decimal @db.Decimal(18, 8)

  @@index([backtestId])
}

model BacktestMetrics {
  id         String   @id @default(uuid())
  backtestId String   @unique
  backtest   Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)

  totalTrades   Int
  winningTrades Int
  losingTrades  Int

  winRate Decimal @db.Decimal(9, 6)

  grossProfit Decimal @db.Decimal(18, 8)
  grossLoss   Decimal @db.Decimal(18, 8)
  netProfit   Decimal @db.Decimal(18, 8)

  // Null means "undefined" (no losing trades) — never faked as 0 or Infinity.
  profitFactor Decimal? @db.Decimal(18, 8)

  averageTrade Decimal @db.Decimal(18, 8)
  averageR     Decimal @db.Decimal(18, 8)

  largestWin  Decimal @db.Decimal(18, 8)
  largestLoss Decimal @db.Decimal(18, 8)

  averageWin  Decimal @db.Decimal(18, 8)
  averageLoss Decimal @db.Decimal(18, 8)

  maxDrawdown        Decimal @db.Decimal(18, 8)
  maxDrawdownPercent Decimal @db.Decimal(18, 8)

  expectancy Decimal @db.Decimal(18, 8)

  maximumConsecutiveWins   Int
  maximumConsecutiveLosses Int
}

// ---------------------------------------------------------------------------
// Milestone 2 — trade journal + analytics foundation (see
// docs/trade-journal-design.md). PostgreSQL remains the only source of
// truth; nothing here depends on LLM memory. BacktestTrade/BacktestMetrics
// above are untouched — the journal tables below are additive.
// ---------------------------------------------------------------------------

enum SetupStatus {
  WATCH
  PREPARE
  READY
  REJECTED
  INVALIDATED
  EXPIRED
}

enum SetupSource {
  BACKTEST
  MANUAL_TEST
  SYSTEM
  TRADINGVIEW
}

enum ExecutionMode {
  BACKTEST
  PAPER
  MANUAL_LIVE
  SKIPPED
}

enum JournalTradeStatus {
  PLANNED
  OPEN
  CLOSED
  SKIPPED
}

// Which table a polymorphic reference (PostTradeAnalysis.tradeId,
// TradeScreenshot.tradeId) points at. Prisma has no cross-table polymorphic
// foreign key, so these references are plain String ids validated at the
// application layer, tagged with this enum instead of a DB-level FK.
enum TradeSource {
  BACKTEST_TRADE
  JOURNAL_TRADE
}

enum PostTradeOutcome {
  WIN
  LOSS
  BREAKEVEN
}

// See shared-types LOSS_CATEGORIES — nothing in this codebase auto-assigns
// these; a row only ever gets one from a genuine analysis mechanism, which
// does not exist yet (see CLAUDE.md, docs/research-methodology.md).
enum LossCategory {
  TREND_MISALIGNMENT
  RESISTANCE_TOO_CLOSE
  SUPPORT_TOO_CLOSE
  HIGH_VOLATILITY
  LOW_VOLATILITY
  LOW_VOLUME
  BREAKOUT_FAILURE
  FALSE_BREAKOUT
  EARLY_ENTRY
  LATE_ENTRY
  NEWS_EVENT
  BAD_RISK_REWARD
  MARKET_REGIME_MISMATCH
  SESSION_TIMING
  GAP_EVENT
  STOP_TOO_TIGHT
  STOP_TOO_WIDE
  UNKNOWN
}

// Milestone 2 subset only. AGENT_STARTED/COMPLETED/FAILED,
// RESEARCH_HYPOTHESIS_CREATED, STRATEGY_VERSION_APPROVED, STRATEGY_PAUSED
// etc. are added via a small additive migration once the runtime agents
// that emit them exist (Milestone 6+) — do not pre-add them now.
enum JournalEventType {
  SETUP_CREATED
  STRATEGY_EVALUATED
  RISK_CALCULATED
  SETUP_APPROVED
  SETUP_REJECTED
  SETUP_INVALIDATED
  SETUP_EXPIRED
  TRADE_READY
  TRADE_EXECUTED
  TRADE_SKIPPED
  TRADE_CLOSED
  POST_TRADE_ANALYSIS_CREATED
  STRATEGY_VERSION_PROPOSED
  // Milestone 3 — TradingView webhook ingestion, correlated on the
  // InboundWebhookEvent's own id (not a Setup's) until SIGNAL_ACCEPTED,
  // which references the Setup that was created. See
  // docs/tradingview-setup.md.
  WEBHOOK_RECEIVED
  WEBHOOK_NORMALIZED
  SIGNAL_ACCEPTED
  WEBHOOK_DUPLICATE_DETECTED
  WEBHOOK_REJECTED
  WEBHOOK_PROCESSING_FAILED
  // Milestone 5 — screenshot generation lifecycle. See docs/screenshot-design.md.
  SCREENSHOT_REQUESTED
  SCREENSHOT_GENERATION_STARTED
  SCREENSHOT_CREATED
  SCREENSHOT_FAILED
  SCREENSHOT_RETRIED
  // Milestone 6 — notification delivery lifecycle. See docs/notifications.md.
  NOTIFICATION_QUEUED
  NOTIFICATION_SENDING
  NOTIFICATION_SENT
  NOTIFICATION_RETRYING
  NOTIFICATION_FAILED
}

enum JournalEntityType {
  SETUP
  JOURNAL_TRADE
  RISK_CALCULATION
  MARKET_SNAPSHOT
  BACKTEST
  BACKTEST_TRADE
  STRATEGY_VERSION
  POST_TRADE_ANALYSIS
  INBOUND_WEBHOOK_EVENT
  TRADE_SCREENSHOT
  NOTIFICATION_DELIVERY
}

enum ScreenshotType {
  PRE_TRADE
  POST_TRADE
}

enum ScreenshotStatus {
  REQUESTED
  GENERATING
  READY
  FAILED
}

enum WebhookProvider {
  TRADINGVIEW
}

enum WebhookProcessingStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  DUPLICATE
  REJECTED
  FAILED
  UNSUPPORTED
}

// ---------------------------------------------------------------------------
// Milestone 6 — notifications + manual trade workflow (see
// docs/notifications.md). Everything here is additive to Milestone 2/3/5.
// ---------------------------------------------------------------------------

enum NotificationProviderType {
  TELEGRAM
  CONSOLE
}

// Setup-lifecycle notifications only in this milestone (see
// docs/notifications.md "Notification policy"). tradeId/tradeSource on
// NotificationDelivery are reserved for a future trade-scoped notification
// type (e.g. a fill confirmation) — nothing in this milestone sets them.
enum NotificationType {
  SETUP_PREPARE
  SETUP_READY
  SETUP_INVALIDATED
  SETUP_EXPIRED
  SETUP_REJECTED
}

enum NotificationDeliveryStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  RETRYING
}

// Optional reason recorded when a READY setup is deliberately not taken
// (see docs/notifications.md / docs/trade-journal-design.md "Skip
// workflow"). Nothing auto-assigns this — only a human choosing SKIP TRADE
// on the dashboard sets it, and it is always optional.
enum SkipReason {
  MISSED_ALERT
  PRICE_MOVED
  MANUAL_DISAGREEMENT
  RISK_TOO_HIGH
  BUSY
  SETUP_NO_LONGER_VALID
  OTHER
}

// Immutable once created — packages/database exposes no update function for
// this model. A Setup needing fresher context gets a new MarketSnapshot row.
model MarketSnapshot {
  id           String     @id @default(uuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  timestamp DateTime
  // Plain String, not a Prisma enum — see the Candle.timeframe note above.
  timeframe String

  windowCandleCount    Int?
  windowStartTimestamp DateTime?
  windowEndTimestamp   DateTime?

  trend1m  String?
  trend5m  String?
  trend15m String?
  trend1h  String?
  trend4h  String?
  trend1d  String?

  atr           Decimal? @db.Decimal(18, 8)
  atrPercentile Decimal? @db.Decimal(9, 6)

  volume           Decimal? @db.Decimal(18, 8)
  volumePercentile Decimal? @db.Decimal(9, 6)

  vwap         Decimal? @db.Decimal(18, 8)
  vwapDistance Decimal? @db.Decimal(18, 8)

  nearestSupport    Decimal? @db.Decimal(18, 8)
  distanceToSupport Decimal? @db.Decimal(18, 8)

  nearestResistance    Decimal? @db.Decimal(18, 8)
  distanceToResistance Decimal? @db.Decimal(18, 8)

  session      String?
  timeOfDay    String?
  dayOfWeek    String?
  marketRegime String?

  metadata Json @default("{}")

  createdAt DateTime @default(now())

  setups Setup[]

  @@index([instrumentId, timeframe, timestamp])
}

// StrategyVersion-style immutability: no update/mutate function exists in
// packages/database for parameters other than `status` (the state machine
// itself). Status transitions are validated in apps/api's setup service.
//
// plannedStop/plannedTarget1 are nullable (Milestone 3): a TRADINGVIEW-
// sourced setup often begins with only a candidate entry (the alert bar's
// close) — the stop/target genuinely aren't known yet, and "unknown
// information must remain unknown" rather than fabricated. plannedEntry
// stays required — always a real observed price at creation time.
model Setup {
  id String @id @default(uuid())

  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id])

  strategyVersionId String
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id])

  marketSnapshotId String
  marketSnapshot   MarketSnapshot @relation(fields: [marketSnapshotId], references: [id])

  direction Direction
  source    SetupSource

  plannedEntry   Decimal  @db.Decimal(18, 8)
  plannedStop    Decimal? @db.Decimal(18, 8)
  plannedTarget1 Decimal? @db.Decimal(18, 8)
  plannedTarget2 Decimal? @db.Decimal(18, 8)

  status          SetupStatus @default(WATCH)
  decisionSummary String?

  metadata Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  // Milestone 3: set only for a TRADINGVIEW-sourced Setup, to the
  // InboundWebhookEvent that produced it. The @unique constraint is what
  // makes Setup creation idempotent per webhook event under a BullMQ retry:
  // if a worker crashes after createSetup but before the InboundWebhookEvent
  // is marked PROCESSED, a retry re-processing the same event must not
  // create a second Setup. The processor checks for an existing row here
  // before creating a new one, the same "database constraint, not
  // check-then-insert" principle as InboundWebhookEvent.fingerprint.
  sourceWebhookEventId String? @unique

  riskCalculations     RiskCalculation[]
  journalTrades        JournalTrade[]
  screenshots          TradeScreenshot[]
  inboundWebhookEvents InboundWebhookEvent[]
  notifications        NotificationDelivery[]

  @@index([instrumentId, status])
  @@index([strategyVersionId])
  @@index([status])
}

// Immutable once created — packages/database exposes no update function.
// A Setup needing a fresh calculation (price moved) gets a new row.
model RiskCalculation {
  id String @id @default(uuid())

  setupId String
  setup   Setup  @relation(fields: [setupId], references: [id], onDelete: Cascade)

  accountEquity  Decimal @db.Decimal(18, 8)
  riskPercentage Decimal @db.Decimal(9, 6)
  riskBudget     Decimal @db.Decimal(18, 8)

  entryPrice Decimal @db.Decimal(18, 8)
  stopPrice  Decimal @db.Decimal(18, 8)

  stopDistancePoints Decimal @db.Decimal(18, 8)
  stopDistanceTicks  Decimal @db.Decimal(18, 8)

  pointValue Decimal @db.Decimal(18, 8)
  tickValue  Decimal @db.Decimal(18, 8)

  estimatedCommission Decimal @db.Decimal(18, 8)
  estimatedSlippage   Decimal @db.Decimal(18, 8)

  riskPerUnit        Decimal @db.Decimal(18, 8)
  calculatedQuantity Int
  estimatedTotalRisk Decimal @db.Decimal(18, 8)
  riskReward         Decimal @db.Decimal(18, 8)

  createdAt DateTime @default(now())

  @@index([setupId, createdAt])
}

// Distinct from BacktestTrade by design — see the model-level comment in
// docs/trade-journal-design.md. Never populated by copying BacktestTrade
// rows; packages/analytics normalizes both for cross-cutting queries.
model JournalTrade {
  id String @id @default(uuid())

  setupId String?
  setup   Setup?  @relation(fields: [setupId], references: [id])

  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id])

  strategyVersionId String
  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id])

  direction Direction

  plannedEntry   Decimal  @db.Decimal(18, 8)
  plannedStop    Decimal  @db.Decimal(18, 8)
  plannedTarget1 Decimal? @db.Decimal(18, 8)
  plannedTarget2 Decimal? @db.Decimal(18, 8)

  actualEntry Decimal? @db.Decimal(18, 8)
  actualExit  Decimal? @db.Decimal(18, 8)

  entryTimestamp DateTime?
  exitTimestamp  DateTime?

  quantity Int?

  plannedRisk Decimal? @db.Decimal(18, 8)

  estimatedFees     Decimal? @db.Decimal(18, 8)
  actualFees        Decimal? @db.Decimal(18, 8)
  estimatedSlippage Decimal? @db.Decimal(18, 8)
  actualSlippage    Decimal? @db.Decimal(18, 8)

  grossPnl  Decimal? @db.Decimal(18, 8)
  netPnl    Decimal? @db.Decimal(18, 8)
  rMultiple Decimal? @db.Decimal(18, 8)

  mfe Decimal? @db.Decimal(18, 8)
  mae Decimal? @db.Decimal(18, 8)

  executionMode ExecutionMode
  status        JournalTradeStatus @default(PLANNED)

  entryNotes String?
  exitNotes  String?

  // Set only when executionMode is SKIPPED, by a human choosing SKIP TRADE
  // on the dashboard. Always optional — a skip needs no justification to be
  // recorded, but one is preserved for future analysis when given.
  skipReason SkipReason?

  // Computed once, at close time, from the sign of netPnl — never
  // fabricated, never client-supplied. Null until CLOSED. See
  // computeJournalTradeClose in journal-trades.ts.
  outcome PostTradeOutcome?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instrumentId])
  @@index([strategyVersionId])
  @@index([executionMode, status])
}

// Append-only — packages/database exposes only a create function, never
// update or delete. entityType/entityId is a polymorphic reference (no
// DB-level FK; see the TradeSource comment above for why).
model JournalEvent {
  id String @id @default(uuid())

  eventType JournalEventType
  timestamp DateTime         @default(now())
  // Monotonic insertion-order tiebreaker. Two events can share an identical
  // millisecond `timestamp` (see docs/tradingview-setup.md "Known
  // limitations" — now fixed); `sequence` gives a deterministic secondary
  // sort key that does not depend on JavaScript's incidental sort
  // stability. Never used as a substitute for `timestamp` itself.
  sequence  Int              @default(autoincrement())

  entityType JournalEntityType
  entityId   String

  correlationId String?

  instrumentId      String?
  strategyId        String?
  strategyVersionId String?

  metadata Json @default("{}")

  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([correlationId, timestamp, sequence])
  @@index([timestamp])
  @@index([instrumentId])
  @@index([strategyId, strategyVersionId])
}

// Nothing in this codebase writes this table automatically — see CLAUDE.md
// and docs/research-methodology.md. A row means a genuine analysis
// mechanism produced it.
model PostTradeAnalysis {
  id String @id @default(uuid())

  tradeId     String
  tradeSource TradeSource

  outcome      PostTradeOutcome
  primaryCause LossCategory?

  contributingFactors LossCategory[]

  confidence Decimal? @db.Decimal(9, 6)

  evidence           Json     @default("{}")
  researchHypotheses String[]

  createdAt DateTime @default(now())

  @@index([tradeId, tradeSource])
}

// Metadata only — see docs/screenshot-design.md. Milestone 5: a real
// renderer/Playwright pipeline now populates this. A READY row is
// immutable historical evidence (docs/architecture.md); a behavior change
// bumps chartConfigVersion and creates a NEW row rather than mutating an
// old one — the two @@unique constraints below are what make that
// immutability a database guarantee, not just a convention. Postgres
// treats NULL as distinct from every other NULL for uniqueness purposes,
// so a PRE_TRADE row (tradeId/tradeSource always null) never collides with
// the tradeId-based constraint, and vice versa for a POST_TRADE row.
model TradeScreenshot {
  id String @id @default(uuid())

  setupId String?
  setup   Setup?  @relation(fields: [setupId], references: [id])

  tradeId     String?
  tradeSource TradeSource?

  // Denormalized so POST_TRADE screenshot journal events can still correlate
  // onto their originating Setup's timeline, since setupId itself must be
  // null for a POST_TRADE row (see assertValidScreenshotTarget in
  // trade-screenshots.ts). Not a foreign key relation field — plain like
  // tradeId/tradeSource above, and deliberately typed to match setupId
  // (also a plain String, not a native Postgres uuid column) rather than
  // an FK, since this column exists purely to carry a correlation value
  // through to createJournalEvent, never to be joined on.
  correlationSetupId String?

  type   ScreenshotType
  status ScreenshotStatus @default(REQUESTED)

  storageProvider String  @default("LOCAL_DISK")
  storageKey      String?
  mimeType        String?
  width           Int?
  height          Int?

  marketSnapshotId String?

  chartConfigVersion String

  renderedAt DateTime?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setupId, type, chartConfigVersion])
  @@unique([tradeId, tradeSource, type, chartConfigVersion])
  @@index([tradeId, tradeSource])
  @@index([setupId])
  // Replaces the plain `[status]` index (Task 1): nothing in this codebase
  // ever queries status alone (grep confirms — every existing lookup is by
  // id, or status combined with id in an `updateMany` guard, neither of
  // which needs a status index at all). These two compound indexes are what
  // GET /health's screenshot-subsystem check actually needs (Task 14, mirrors
  // InboundWebhookEvent's `[processingStatus, receivedAt]` pattern exactly)
  // and each still serves a plain status-equality filter via its leading
  // column, so keeping the old single-column index alongside them would be
  // pure write-amplification with no query it serves better.
  @@index([status, renderedAt])
  @@index([status, updatedAt])
}

// ---------------------------------------------------------------------------
// Milestone 3 — TradingView webhook ingestion (see docs/tradingview-setup.md).
// PostgreSQL remains the only source of truth; Redis (BullMQ + the realtime
// pub/sub channel) is ephemeral. Everything here is additive to Milestone 2.
// ---------------------------------------------------------------------------

// Explicit exchange+symbol -> Instrument mapping. A webhook naming an
// unmapped symbol is REJECTED (UNKNOWN_INSTRUMENT) — never auto-created,
// never fuzzy-matched.
model TradingViewInstrumentMapping {
  id String @id @default(uuid())

  exchange String
  symbol   String

  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([exchange, symbol])
}

// The durable record of one physical webhook delivery. `fingerprint` is the
// actual idempotency guarantee (unique constraint — a duplicate delivery
// cannot even be inserted). Everything except the processing-lifecycle
// fields (processingStatus/processingStartedAt/processingCompletedAt/
// failureCode/failureMessage/setupId/normalizedPayload) is set once at
// creation and never changed — packages/database exposes no function that
// mutates provider/receivedAt/schemaVersion/rawPayload/fingerprint.
model InboundWebhookEvent {
  id String @id @default(uuid())

  provider      WebhookProvider
  receivedAt    DateTime        @default(now())
  schemaVersion Int

  // Never put credentials in a webhook alert message — see
  // docs/tradingview-security.md. This column stores exactly what was
  // received (parsed JSON), for audit.
  rawPayload Json

  // Populated once normalization succeeds; null before that or if it never
  // succeeded (REJECTED/UNSUPPORTED).
  normalizedPayload Json?

  fingerprint String @unique

  processingStatus      WebhookProcessingStatus @default(RECEIVED)
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?

  // Freeform string, not a DB enum (see shared-types WEBHOOK_FAILURE_CODES)
  // so a genuinely unanticipated failure can still record a useful message
  // without a migration.
  failureCode    String?
  failureMessage String?

  setupId String?
  setup   Setup?  @relation(fields: [setupId], references: [id])

  createdAt DateTime @default(now())

  @@index([provider, receivedAt])
  @@index([processingStatus])
  @@index([processingStatus, receivedAt])
  // Backs findMostRecentInboundWebhookEvent's unfiltered "newest row"
  // query. A compound index's leading column must have an equality filter
  // for the trailing column's ORDER BY to use the index, so
  // [provider, receivedAt] and [processingStatus, receivedAt] above cannot
  // serve a query with no `where` clause at all - this plain single-column
  // index is what makes that `take: 1` query an index scan instead of a
  // full table scan.
  @@index([receivedAt])
  @@index([setupId])
}

// One row per (setupId, notificationType, templateVersion) — the
// @@unique constraint below is the actual idempotency guarantee (a
// database constraint, not check-then-insert), the same pattern
// TradeScreenshot and InboundWebhookEvent already use. A BullMQ retry, or
// two concurrent requests for the same setup reaching READY twice, must
// converge on this one row rather than sending a duplicate Telegram
// message — see requestOrRetryNotification in
// notification-deliveries.ts. tradeId/tradeSource exist for a future
// trade-scoped notification type; every row this milestone creates has
// them null and setupId set.
model NotificationDelivery {
  id String @id @default(uuid())

  setupId String?
  setup   Setup?  @relation(fields: [setupId], references: [id])

  tradeId     String?
  tradeSource TradeSource?

  provider         NotificationProviderType
  notificationType NotificationType
  templateVersion  String

  status       NotificationDeliveryStatus @default(QUEUED)
  attemptCount Int                        @default(0)

  queuedAt  DateTime  @default(now())
  sendingAt DateTime?
  sentAt    DateTime?

  externalMessageId String?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setupId, notificationType, templateVersion])
  @@index([setupId])
  @@index([status, updatedAt])
  @@index([status, sentAt])
}
