# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (source of truth) ---
POSTGRES_USER=trading_copilot
POSTGRES_PASSWORD=trading_copilot_dev_password
POSTGRES_DB=trading_copilot
POSTGRES_PORT=5432
DATABASE_URL="postgresql://trading_copilot:trading_copilot_dev_password@localhost:5432/trading_copilot?schema=public"

# --- Redis (ephemeral queue/cache only, never source of truth) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- apps/api ---
API_PORT=3001

# TradingView webhook ingestion rate limiting (POST /webhooks/tradingview
# only - see docs/tradingview-security.md "production controls"). Generous
# defaults for local dev; tune for real alert volume in production.
TRADINGVIEW_WEBHOOK_RATE_LIMIT=120
TRADINGVIEW_WEBHOOK_RATE_TTL_SECONDS=60

# --- apps/dashboard ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
DASHBOARD_PORT=3000

# --- apps/worker ---
WORKER_CONCURRENCY=2

# How long a TRADINGVIEW-sourced Setup lives (from its alert's barTime)
# before it auto-expires if never actioned - see docs/tradingview-setup.md
# "Setup expiration".
TRADINGVIEW_SETUP_EXPIRY_MINUTES=60

NODE_ENV=development
