# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (source of truth) ---
POSTGRES_USER=trading_copilot
POSTGRES_PASSWORD=trading_copilot_dev_password
POSTGRES_DB=trading_copilot
POSTGRES_PORT=5432
DATABASE_URL="postgresql://trading_copilot:trading_copilot_dev_password@localhost:5432/trading_copilot?schema=public"

# --- Redis (ephemeral queue/cache only, never source of truth) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- apps/api ---
API_PORT=3001

# --- apps/dashboard ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
DASHBOARD_PORT=3000

# --- apps/worker ---
WORKER_CONCURRENCY=2

NODE_ENV=development
