{
  "name": "@trading-copilot/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node -c blue,green \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^12.0.3",
    "@trading-copilot/analytics": "workspace:*",
    "@trading-copilot/database": "workspace:*",
    "@trading-copilot/shared-types": "workspace:*",
    "@trading-copilot/trading-domain": "workspace:*",
    "bullmq": "^6.3.6",
    "decimal.js": "^10.4.3",
    "ioredis": "^6.0.0",
    "multer": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@swc/helpers": "^0.5.23",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.17.9",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^2.1.4"
  }
}
